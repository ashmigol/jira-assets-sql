# Required
JIRA_SITE=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=            # https://id.atlassian.com/manage-profile/security/api-tokens

# Optional
ASSETS_SCHEMA=             # default object schema id (the number in .../object-schema/<id> URLs)
ASSETS_WRITABLE_SCHEMAS=   # comma-separated schema ids that .apply may change; EMPTY = read-only everywhere
ASSETS_WORKSPACE_ID=       # auto-discovered from JIRA_SITE when empty
ASSETS_HOME=               # local copies, change log, backups, history (default ~/.local/share/assets)
